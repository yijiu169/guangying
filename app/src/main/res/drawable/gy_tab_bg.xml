<?xml version="1.0" encoding="utf-8"?>
<!-- 排行榜分类 Tab 背景：玻璃胶囊风格。
     聚焦 = gy_accent 描边 + 半透明主色填充；选中(当前分类) = 淡主色；未选中 = 玻璃灰。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/gy_accent_50" />
            <stroke android:width="2dp" android:color="@color/gy_accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/gy_accent_12" />
            <stroke android:width="1dp" android:color="@color/gy_accent_50" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/gy_glass" />
            <stroke android:width="1dp" android:color="@color/gy_glass_stroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
