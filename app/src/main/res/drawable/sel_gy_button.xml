<?xml version="1.0" encoding="utf-8"?>
<!-- 「光影」胶囊按钮（详情页操作按钮等）：聚焦主色实心，非聚焦玻璃 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="@color/gy_accent" />
            <stroke android:width="2dp" android:color="@color/gy_accent" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="@color/gy_accent_12" />
            <stroke android:width="1dp" android:color="@color/gy_glass_stroke" />
        </shape>
    </item>
</selector>
