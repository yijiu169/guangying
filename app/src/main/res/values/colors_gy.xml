<?xml version="1.0" encoding="utf-8"?>
<!-- 「光影」设计规范色板（与设计稿 .tv / .rail / .poster 一一对应） -->
<resources>
    <!-- 页面背景 #0A0C10 -->
    <color name="gy_bg">#FF0A0C10</color>
    <!-- 主色：焦点 / 强调 #46D6C4 -->
    <color name="gy_accent">#FF46D6C4</color>
    <!-- 金色：评分 #E8B94F -->
    <color name="gy_gold">#FFE8B94F</color>
    <!-- 豆瓣绿 #3CB963（行标题标签 / rail 指示条渐变末端） -->
    <color name="gy_douban">#FF3CB963</color>
    <!-- 正文 #EEF2F7 -->
    <color name="gy_text">#FFEEF2F7</color>
    <!-- 次要灰 #98A4B6 -->
    <color name="gy_text_dim">#FF98A4B6</color>
    <!-- Hero 简介 #C4CDDB -->
    <color name="gy_text_desc">#FFC4CDDB</color>
    <!-- 主色 12%（焦点面板底） -->
    <color name="gy_accent_12">#1F46D6C4</color>
    <!-- 主色 50%（焦点描边） -->
    <color name="gy_accent_50">#8046D6C4</color>
    <!-- 玻璃面板：rgba(255,255,255,0.06) -->
    <color name="gy_glass">#0FFFFFFF</color>
    <!-- 玻璃描边：rgba(255,255,255,0.08) -->
    <color name="gy_glass_stroke">#14FFFFFF</color>
    <!-- 豆瓣绿描边（行标题标签 border 40%） -->
    <color name="gy_douban_40">#663CB963</color>
</resources>
