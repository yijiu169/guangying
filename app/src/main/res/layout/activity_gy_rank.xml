<?xml version="1.0" encoding="utf-8"?>
<!-- 「光影」排行榜：全屏 gy_bg 深色底。
     顶部标题栏（左「排行榜」+ 右分类胶囊 Tab），下方横向海报墙（TvRecyclerView）。
     海报卡片复用 item_gy_poster，不在此新建卡片布局。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gy_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- 顶部标题栏：左标题 + 右分类 Tab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRankTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="排行榜"
                android:textColor="@color/gy_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <HorizontalScrollView
                android:id="@+id/tabScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:scrollbars="none"
                android:fillViewport="false">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 主体：横向滚动海报墙 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rankRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true" />

            <TextView
                android:id="@+id/rankEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="暂无数据，按 OK 重试"
                android:textColor="@color/gy_text_dim"
                android:textSize="14sp"
                android:background="@drawable/sel_gy_hint"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="14dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
