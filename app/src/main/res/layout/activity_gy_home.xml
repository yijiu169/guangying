<?xml version="1.0" encoding="utf-8"?>
<!--
  「光影」原生 TV 首页
  ┌──────────────────────────────────────────────────┐
  │ rail(88dp) │ Hero：满幅渐变，占屏高 46%           │
  │  首页      │ 标题 28sp / ★评分·年份·正片 / 简介   │
  │  搜索      │ ● ● ● ●（轮换指示点）                │
  │  排行      ├──────────────────────────────────────┤
  │  我的      │ 豆瓣热门  [卡片][卡片][卡片]…        │
  │  设置      │ 最新上架  [卡片][卡片][卡片]…        │
  │            │ 高分佳作  [卡片][卡片][卡片]…        │
  └──────────────────────────────────────────────────┘
  Hero 与行区用 layout_weight 46/54 实现「占屏幕高 46%」，不写死 px。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gy_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ==================== Hero ==================== -->
        <FrameLayout
            android:id="@+id/heroArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="46"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivHeroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.32"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- 随焦点同步换色的渐变层（Java 里按条目重建 GradientDrawable） -->
            <View
                android:id="@+id/heroTint"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gy_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="116dp"
                android:paddingTop="12dp"
                android:paddingEnd="48dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#B3000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHeroRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/gy_gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/gy_text_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHeroIntro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="2"
                    android:maxWidth="620dp"
                    android:textColor="@color/gy_text"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/heroDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </FrameLayout>

        <!-- ==================== 行区（可纵向滚动，3 行内容按需滚动） ==================== -->
        <!-- 注意：这里必须保持 clipChildren=true（默认），否则滚动后上方的内容会溢出盖住 Hero。
             卡片放大的溢出由 rowContainer / 每一行的 body / recycler 的 clipChildren=false 承担。 -->
        <ScrollView
            android:id="@+id/rowScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="54"
            android:focusable="false"
            android:paddingStart="116dp"
            android:paddingTop="6dp"
            android:paddingEnd="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="20dp" />
        </ScrollView>
    </LinearLayout>

    <!-- ==================== 左侧 rail（宽 88dp，整列垂直居中） ==================== -->
    <LinearLayout
        android:id="@+id/railBar"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />
</FrameLayout>
